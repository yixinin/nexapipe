# Nexapipe 2FA Configuration Example
#
# Start from this file and edit your own copy:
#
#   cp config.toml.2fa.example config.toml    # config.toml is gitignored
#
# **The secret below is published.** It is in a public repository, so anybody
# can compute a valid code from it. It is here to show what an enrolled client
# looks like, not to be used as one: replace it before the listener is
# reachable, with
#
#   nexapipe --generate-2fa client-001 --force
#
# The Node ID is a reachability credential on its own — anybody who learns it
# reaches every route on a server that has 2FA off — and the 2FA secret is
# what closes that. A published secret is a published way in.
#
# Every command in the comments below takes `--config config.toml` rather than
# `--config config.toml.2fa.example` on purpose: `--generate-2fa` and
# `--generate-invite --registration` **write back into the file they are pointed
# at**, so aiming them at this example would rotate the secrets in git.
#
# The secrets below are the only credential gating the iroh listener, so keep
# the file private: `chmod 600` it. The server does **not** refuse to start on
# a file another account can read — it says so once in the log and starts
# anyway, because a `0644` bind mount has to start (ROADMAP §3.5). The mode is
# the operator's to set, and the warning is the only thing that says so.
#
# This file is the 2FA one; the sibling `config.toml.example` writes out every
# other section (relay modes, all four route modes, `[log]`) at length and
# turns `[auth]` on without enrolling a client, so a fresh install refuses
# every connection until one is enrolled. `[[routes]]` and `[auth.clients]`
# are reread every 5 s and take effect without a restart; `[auth]
# enabled = true` is picked up live too (but turning it off is not), while
# `[server]`, `[iroh]`, `[peers]`, the `[auth]` TOTP parameters and `[log]`
# need a restart.

# ===== Server Configuration =====

# Removed: `default_backend` no longer exists, and a config that still names it
# is refused at startup rather than silently ignored. A host with no
# `mode = "http"` route is answered 404; "send everything here" is spelled as a
# catch-all route (see the `host_pattern = "*"` entry below), which is also
# load-balanced and health-checked. `passthrough` and `tcp`/`udp` lookups never
# had a fallback and still have none.
#debug = false

[server]
# Left unset, i.e. the plaintext listener stays closed. It is the one entry
# point 2FA does not cover — the handshake runs on the iroh listener — so with
# 2FA enabled there is no reason to have anything else open. Enable it only for
# a client on this host (a sidecar, another container sharing the network
# namespace); anything beyond that needs a reverse proxy or a firewall in front.
# listen_addr = "127.0.0.1:8080"
# Required whenever listen_addr is not loopback: without it the server refuses
# to start, because a non-loopback bind publishes every http route and every
# passthrough backend to whoever can reach the port.
# expose = false
# TLS is terminated by the backend (Caddy &co), not here. See README.md, "TLS".
# `tls_enabled` / `tls_listen_addr` / `cert_path` / `key_path` still parse, are
# logged as ignored, and can be deleted.

[iroh]
# Stable endpoint identity — the same Node ID across restarts, which is what
# makes a printed invite QR code stay valid. Generate one with:
#
#   nexapipe --generate-secret
#
# `--generate-invite` reads this too, and refuses without either it or
# `--endpoint-id`, so set it before printing an invite (or pass --endpoint-id).
# secret_key = "your-hex-encoded-secret-key"
bind_port = 0
# Also bind [::] on that port, so clients that reach this host over IPv6 are
# answered there too. The IPv4 socket stays bound; this adds one. The IPv6 bind
# is allowed to fail, so a host without IPv6 still starts. Ignored without
# bind_port.
bind_ipv6 = false
# Which relay to use. One of: default (all N0 relays; the default when unset),
# pinned (the single built-in relay this project pins), custom (relay_url below),
# disabled (no relay transport at all — a peer's relay becomes unusable too).
# relay_mode = "default"
# Only read with relay_mode = "custom", and then required.
# relay_url = "https://relay.example.com"
# Bearer token for that relay; it has to be configured on both sides.
# relay_auth_token = ""

# ===== Peer allow-list (optional, runs before 2FA) =====
# Which client Node IDs may complete a QUIC handshake at all. A peer that is not
# listed is closed before any stream is opened, so this is checked earlier than
# everything below. It is not a substitute for 2FA - it answers "may this Node ID
# be here", where 2FA answers "who is it" - but the two compose usefully: an
# unlisted peer never reaches the handshake, and a listed one still has to
# authenticate. Take each Node ID from the client app. A typo is a startup error
# and an empty list is refused, so neither can silently lock you out.
# [peers]
# allow = [
#   "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2",
# ]

# ===== 2FA Authentication Configuration (server side) =====
# When enabled, every client connection must prove a credential before proxying
# is allowed — a TOTP response, or, for a device registered with a key, a
# signature over that connection's challenge. `enabled` is picked up live by the
# config watcher, taking effect for connections opened after the reload; turning
# it back *off* on a running server is refused, so disabling 2FA needs a
# restart. The TOTP parameters below are read once at startup - restart after
# changing any of them.
[auth]
enabled = true
algorithm = "sha1"      # sha1, sha256, sha512
time_step = 30          # TOTP time step in seconds
digits = 6              # Number of digits in TOTP code
window = 1              # Time window tolerance (accept +/- N steps)
max_attempts = 5        # Max failed attempts before lockout
lockout_duration = 300  # Lockout duration in seconds (5 minutes)

# Issuer label shown by the authenticator app, and used for both halves of the
# otpauth:// URI (the label before the colon and the `issuer` parameter).
# Falls back to "NexaPipe" when unset, and can be overridden per run with
# `--issuer` when printing the QR code.
issuer = "NexaPipe"

# Client configurations.
#
# Generate a secret and its enrollment QR code; the secret is written into this
# file as `[auth.clients.client-001] secret`, keeping comments and formatting:
#
#   nexapipe --generate-2fa client-001 --config config.toml
#   nexapipe --generate-2fa client-001 --qr-format svg --qr-out client-001.svg
#                                       # --qr-out writes the file 0600 on Unix
#   nexapipe --generate-2fa client-001 --force --config config.toml
#                                       # rotate: every enrolled device rescans
#
# A client that already has a secret prints that one instead of a new one, so a
# second run cannot hand out credentials the server rejects — that is what
# `--force` is for.
#
# Scanning is standard otpauth://, so any authenticator app works, not just the
# NexaPipe app. A client already configured here can be shown again with:
#
#   nexapipe --show-2fa client-001 --config config.toml
#
# That only carries the 2FA half. To hand a client everything at once — the
# endpoint, the domains and its credentials in a single scan — print an endpoint
# invite instead:
#
#   nexapipe --generate-invite client-001 --config config.toml
#   nexapipe --generate-invite client-001 --invite-name Home --qr-out invite.svg
#
# The identity comes from [iroh] secret_key above unless --endpoint-id is
# passed; the domains come from [local_proxy] proxy_domains unless
# --invite-domains is passed; the relay comes from [iroh] relay_url when that
# one is `custom`. Dropping the client id prints the same invite without the 2FA
# block, for people who already have their own credentials.
#
# That code carries the TOTP secret in the clear — it is a password that happens
# to be shaped like an address, and it stays a password for as long as the
# secret lives. The enrollment form below is the one that is not:
#
#   nexapipe --generate-invite client-001 --registration --config config.toml
#
# It writes a one-time enrollment token into this file as
# `[auth.clients.client-001] pending_enrollment` and puts the token in the link
# instead of the secret. The first device to connect trades it for a freshly
# generated secret, and the server burns the token and stores that secret in the
# same write, so a copy of the link stops being a credential the moment it is
# used. Until then it is one: an unspent link hands out this client's secret to
# whoever holds it, so deliver it to the device over a channel you already
# trust and do not leave it sitting in a chat log or a ticket. Two consequences:
# which secret enrollment rotates depends on whether the device named itself — a
# named device is filed under `[auth.clients.client-001.devices.<name>]`, so only
# its own credential changes, while one that names none is filed under this
# client's `secret` and takes every device sharing it along, so they all have to
# scan again; and generating another `--registration` invite replaces the
# outstanding token, which is how a link that never arrived gets revoked. Never
# write the key by hand — let the command own it.
#
# The token is only worth anything while the server runs the 2FA handshake, so
# the enrollment form needs `enabled = true` here — which is what this file
# ships. With 2FA off the server never asks anybody for a credential, and the
# invite falls back to carrying the secret, with a warning saying so.
#
# Warning: changing algorithm, time_step or digits here does NOT change what the
# app does once it has scanned the code. Those values are only read when the
# enrollment QR code is generated; keep them stable after clients are enrolled.
#
# Both invite forms above need the client to exist already, since they hand out
# the secret this file holds. To create one and invite it in a single run, add
# --create-client — it generates the secret, writes it here and prints an
# invite for it, which is two commands folded into one:
#
#   nexapipe --generate-invite client-003 --create-client --config config.toml
#   nexapipe --generate-invite client-003 --create-client --registration
#
# A client that this run creates is the one case where the enrollment form is
# the default: the secret it mints was in nobody's hands a moment earlier, so
# nothing is lost by the first device trading the token for a fresh one — and
# the link stops being a credential the moment it is scanned. A client that
# exists already keeps the secret it has, and the link that carries it is a
# password for as long as that secret lives.
#
# It only ever creates a client that is missing entirely: run against one that
# already has a secret it reuses that secret rather than issuing a second, so an
# existing device is never locked out. Rotating a secret stays explicit:
# --generate-2fa client-001 --force.
[auth.clients.client-001]
secret = "JBSWY3DPEHPK3PXP" # Base32-encoded secret
created_at = "1723756800"
# Optional per-client host authorization. Patterns use the same spelling as a
# route's host_pattern — an exact name or a "*.suffix" wildcard,
# case-insensitively. Left unset, the client may reach every route (the
# default). An empty list means "may connect, may reach nothing".
# A restricted client also never falls back to default_backend, and its
# refusals look exactly like "no route" (404 / NoRoute / hang-up), so the
# restriction cannot be used to probe which hosts exist.
# allow_hosts = ["api.example.com", "*.db.example.com"]
# The same question asked of ports rather than of names: a host is a name, a
# port is a service on that name, and the port list is what keeps a client off
# the services of a name it may have. Left unset, the client may reach every
# port (the default). Checked where the client names a port — the tunnel
# preface always does, and an HTTP request's Host header may — and a request
# that names no port is not checked, because there is no port to hold against
# it. An empty list denies every port that is checked.
# The tunnel is where the list separates services: the preface names the port
# the client wants, and the route decides where that service is answered from
# (client_ports only picks the route, it never decides where the connection
# goes). The HTTP path routes by host alone, so there the list refuses a
# request that names a port off it and nothing more.
# allow_ports = [443, 8443]
#
# ...and the port a request is *served from* is a different port from the one
# the client names. A client asks for https://api.example.com and the proxy
# serves it from http://127.0.0.1:18080; the port it named is a virtual one
# and the request never reaches it.
#
# allow_ports_strict checks the list against that second port - the backend's -
# so a client limited to 443 cannot reach a route whose backend listens on
# 18080, however the request was spelled. It also covers the TLS
# passthrough, which had no port check at all.
#
# Off by default, because it changes what an existing configuration allows: a
# client limited to 443 whose route's backend listens on 18080 is refused.
# That is the correct answer, and it is not the answer a deployed
# configuration was written against. Turn it on having looked at where your
# backends actually listen.
#
# The flag does not say which of the two rules you have, so the server says it
# for you: with a client that has a port list and this flag off, the startup
# log names that client and says the list is held against the port the client
# names - and that a request naming no port is not checked at all.
# `nexapipe client list` shows the same thing per client.
# allow_ports_strict = true
# The server keeps `failed_attempts`, `locked_until` and `last_used` for a
# client that has failed a handshake, so a lockout survives a restart. Those
# three live in `state.toml` beside this file, not here — this file is the
# operator's, and the server does not rewrite it for its own counters. They are
# still read from here, so a file written before the state file existed keeps
# its lockouts.
# Nothing to configure; and `pending_enrollment`, written by the enrollment
# command above, should never be edited by hand either.
#
# A device that named itself at enrollment is filed below rather than in the
# `secret` above, which is what lets one be revoked without touching the rest —
# including the devices still answering as nobody, which is what that one is for.
# Nothing here is written by hand either: enrollment files a device on its own,
# and so does `nexapipe client add client-001 --device <name>`. A client with no
# `devices` table at all — which is every client written before this existed —
# authenticates exactly as it always did.
#
# An entry below carries exactly one credential, and it is one of two kinds.
# The `secret` on the laptop is a TOTP seed issued at enrollment, and that device
# answers each handshake the way clients always have — an HMAC keyed by the seed
# plus a code. A `public_key` is the other kind: the half of an Ed25519 pair
# whose private half stays on the device, which proves itself by signing the
# same challenge instead. What the server holds then cannot be replayed: a copy
# of this file is no way in "as that device", where a copied `secret` is the
# credential itself. That is not the same as no way in at all — this file still
# holds the client's own `secret`, and the paragraph below says what that one is
# worth. And no code has to come from anywhere, which is what a device that runs
# unattended wants. A wrong signature counts toward the lockout exactly like a
# wrong code. Exactly one kind per entry: both, or neither, is refused at load
# rather than one of two credentials being silently ignored.
#
# The shell has the same two forms — `client add client-001 --device <name>`
# issues a seed; the key kind is one word more:
#
#   nexapipe client add client-001 --device phone --public-key <64 hex chars>
#
# The public half is what an operator registers; the device generates the pair,
# and the private half never travels. `client list` marks such a device `key`.
#
# The `secret` above is still a credential of its own: it is what a device that
# names none answers with. Revoking a device strikes one entry out of the table
# below and leaves it standing, so a secret that has been handed out — in an
# invite link, or to every install that enrolled before this table existed —
# keeps working for anyone who simply leaves the device name out. Set
# `unnamed_device_allowed = false` once every device of this client has one of
# its own, and that shared secret stops being a way in:
#
#   unnamed_device_allowed = false
#
# Left out, or true, the client answers as it always has. Turning it off before
# every device is enrolled locks out the ones that never named themselves.
[auth.clients.client-001.devices.laptop]
secret = "LAPTOPSECRET"     # Base32-encoded TOTP seed, issued at enrollment
created_at = "1723756800"

# The same table, one device later, carrying the other kind of credential:
# [auth.clients.client-001.devices.phone]
# public_key = "a1b2c3…"    # 64 hex characters, the public half of an Ed25519 key
# created_at = "1723756800"

[auth.clients.client-002]
secret = "KBSWY3DPEHPK3PXQ"
created_at = "1723756800"

# ===== Routes =====
# Which mode applies is decided before any matching happens, by the first byte
# of the stream, so the modes never see each other's traffic:
#   http (default)   re-issues a parsed request to an http:// or https://
#                    backend; an https:// one is reached over TLS and verified
#                    against the machine's roots (see config.toml.example for
#                    [backends] ca_file, [retry] and [circuit_breaker])
#   passthrough      copies raw bytes; TLS stays with the backend (Caddy)
#   tcp / udp        L4 tunnel, one QUIC bi-stream per flow
[[routes]]
host_pattern = "*"
path_pattern = "/"          # ignored by passthrough and L4 routes
backends = ["http://localhost:3000"]
strategy = "round_robin"      # or "random", or "least_conn"
# mode = "tcp"             # backends then have to be host:port, e.g. "10.0.0.5:5432"
# modes = ["http", "tcp"]  # one backend pool serving several modes
# client_ports = [5432]    # tcp/udp only: which client ports this route matches
# idle_timeout_secs = 60   # udp only: seconds of silence before a flow is closed

# ===== Waiting on a backend, and bounding each phase (all optional) =====
# Seconds, all optional; leaving the section out keeps the defaults. The first
# two cover one step of talking to a backend each; the six after them bound the
# phases of the exchange itself. Read once at startup, so editing any of them
# takes a restart.
# [timeouts]
# connect_secs = 10        # dialing it: HTTP requests, WebSocket upgrades,
#                          # TLS passthrough and tcp tunnels all dial one
#                          # connection, and all wait this long
# response_secs = 30       # waiting for its answer: the status line, or for a
#                          # websocket, the upgrade response
# header_secs = 30         # a client sending its request head
# body_secs = 300          # a client sending its request body
# response_idle_secs = 120 # silence between response chunks
# l4_flow_secs = 3600      # the whole life of an L4 tunnel; a route's own
#                          # flow_timeout_secs overrides it per route
# l4_idle_secs = 60        # silence between UDP datagrams
# tls_hello_secs = 10      # the TLS ClientHello read
#
# A stream's first byte says which protocol it carries, so the wait for it is
# the longer of header_secs and tls_hello_secs. `0` is refused for every key,
# and so is anything past 86400 (a day); the two backend keys stop at 3600.

# ===== Auxiliary listener (off by default) =====
# Loopback only, nothing authenticates, so there is no `expose` here. Serves
# `/healthz` always and `/metrics` when [metrics] enabled = true. `listen_addr`
# is not hot-reloadable: moving a listener is a restart.
# [admin]
# listen_addr = "127.0.0.1:9090"
#
# The token for /v1/* is generated on first start into <this file>.admin-token;
# there is no key for it here. `nexapipe status` reads it from there.
#
# [metrics]
# enabled = true

# ===== Client Local Proxy Configuration (client side) =====
[local_proxy]
enabled = true
listen_addr = "127.0.0.1:8080"
proxy_domains = ["example.com", "api.example.com"]

# One entry per endpoint this client proxies to; `domains` steers those hosts
# here. A Node ID is the one to reach for when the endpoint's addresses move: it
# is resolved live. A ticket carries the addresses it was printed with, so it
# goes stale under exactly those conditions — use one only to give a client a
# first contact with no relay or DNS to lean on.
[[local_proxy.nodes]]
server_node_id = "your-server-node-id"
domains = ["example.com", "api.example.com"]

# The single-endpoint spelling still parses but is deprecated: adding a second
# server means rewriting it, where `nodes` only takes another entry.
# server_node_id = "your-server-node-id"

# Client 2FA credentials: must match a client configured in [auth.clients] on
# the server, otherwise every connection will be rejected — the QUIC handshake
# succeeds and the server closes the stream once the handshake deadline passes.
# Scanning an invite QR code fills in exactly these fields.
[local_proxy.two_factor]
enabled = true
client_id = "client-001"
secret = "JBSWY3DPEHPK3PXP"
algorithm = "sha1"

# Rotating log files under ./logs next to the console output are on by default
# (`file`, `rotation`, `max_files`, `redact_query`, …); every key and its default
# is written out in config.toml.example under `[log]`.
# NEXAPIPE_LOG_DIR overrides the directory without touching this file.
