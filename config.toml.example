# Nexapipe configuration example
#
# Usage:
#   cp config.toml.example config.toml     # config.toml is gitignored: it is the operator's live config
#   nexapipe                                # picks up ./config.toml by default
#
# This is the general example: every section written out, with 2FA on - the
# same setting the generated first-run template and config.toml.2fa.example
# ship. See config.toml.2fa.example for the short file that is only about 2FA.
#
# No file at the path? On a first server start, the binary writes a minimal
# `config.toml` for you (2FA on, no routes, no clients) instead of refusing to
# start. This file is the long version of that — every section written out —
# for when you want to read it instead of running it. The auto-generated file
# itself is heavily commented at the top of the template, with the same
# shape and the same next step: enroll the first client with
# `nexapipe --generate-invite client-001 --create-client --config config.toml`.
#
# The docker setup uses a different default: docker-compose.yaml binds
# `./config` to `/app/config` and sets `NEXAPIPE_CONFIG_DIR=/app/config`, so the
# container picks up `/app/config/config.toml` by default. Locally this file
# is what you want; in the container you want `config/config.toml`.
#
# Reloading: the file is re-read every 5 seconds. `[[routes]]` is applied live;
# a config that fails to parse or validate is reported and ignored, so a
# half-saved edit cannot take the proxy down. `[auth]` and `[auth.clients]` are
# applied live too — see the `[auth]` section below for what that does and does
# not cover. The rest is read once at startup and needs a restart: `[server]`,
# `[iroh]`, `[log]`.
#
# Every key is optional. What follows is "what it looks like when you use it",
# not a minimal config.

# ============================================================
# Top level
# ============================================================

# Removed: `default_backend` no longer exists, and a config that still names it
# is refused at startup rather than silently ignored. A host with no
# `mode = "http"` route is answered 404; "send everything here" is spelled as a
# catch-all route, which is also load-balanced and health-checked:
#
#   [[routes]]
#   host_pattern = "*"
#   mode = "http"
#   backends = ["http://127.0.0.1:18080"]
#
# `passthrough`, `tcp` and `udp` lookups never had a fallback and still have
# none - they refuse instead.

# Debug logging.
debug = false

# ============================================================
# [server] - direct plaintext ingress (off by default)
# ============================================================

[server]
# Left unset = the listener is never bound, and that is the default.
#
# Nothing on this listener is authenticated: the 2FA handshake runs in the iroh
# accept loop, so a request arriving here reaches a route without ever being
# asked for a credential. Use it only for something on the same host (a sidecar,
# a container sharing the network namespace), and keep it on 127.0.0.1.
# listen_addr = "127.0.0.1:8080"

# Allows listen_addr to name a non-loopback address (e.g. 0.0.0.0:8080).
# Turning it on publishes every `http` route and every `passthrough` backend to
# anyone who can reach the port, with no authentication in between. Enable it
# only when something downstream does the gating (reverse proxy, firewall,
# private network). Combined with `[auth] enabled = true` it is refused at
# startup.
expose = false

# Removed keys, still accepted so an old config.toml keeps parsing:
# tls_enabled / tls_listen_addr / cert_path / key_path. TLS is terminated by the
# backend now; this process holds no certificate.

# ============================================================
# [iroh] - the QUIC tunnel endpoint
# ============================================================

[iroh]
# The endpoint identity. Leave this out: nexapipe generates one on first start
# and writes it here, so the Node ID survives a restart without a copy-paste.
# Clients that fill in `server_node_id` need that.
#
# Set it by hand only to move an identity to another host, or to pin one when
# the config cannot be written (a read-only mount): the key in the file is the
# identity, and a server that cannot write it has a different Node ID after every
# restart. NEXAPIPE_NO_PERSIST_IDENTITY=1 asks for exactly that and leaves the
# file alone. A value that does not parse refuses the start rather than silently
# becoming a new identity each time.
# secret_key = "your-hex-encoded-secret-key"

# To keep the key out of this file entirely — so the config itself holds no
# credential and can stay world-readable (a shared bind mount, a file an
# operator edits without worrying) — point at a file holding the hex key and
# nothing else:
#
#   secret_key_file = "/run/secrets/iroh-key"
#
# A relative path is read against this file's directory. A missing file is
# created on first start (mode 0600 on Unix) with a generated key; an empty
# one, an unreadable one, or one another account can read or write refuses
# the start. Naming the key here *and* in `secret_key` is refused — one
# credential, one source.
#
# The environment can carry the key instead of this file:
# NEXAPIPE_IROH_SECRET_KEY holds the hex key itself,
# NEXAPIPE_IROH_SECRET_KEY_FILE holds a *path* to the file that does (the
# docker-compose setup uses the latter to keep the key in its own mounted
# directory). A missing env-named file is generated into on first start, the
# same as this key. Naming the key by more than one source — a value and a
# path, the environment and this file, either and `secret_key` — refuses the
# start rather than ranking them.
# secret_key_file = ""

# Fixed UDP port; unset means an ephemeral one.
bind_port = 0

# Also bind [::] on that port, so the endpoint answers over IPv6 as well. The
# IPv4 socket stays — this adds one, it does not replace one — and the bind is
# allowed to fail, so a host with no IPv6 still starts (and logs it).
# Ignored without bind_port: there would be no port to keep both families on.
bind_ipv6 = false

# Relay mode: pinned / default / disabled / custom. Unset means default.
#   default  - every N0 relay, home relay chosen by latency; it can migrate
#              between relays, which drops the connections routed through it
#   pinned   - one fixed N0 relay (Singapore). Use when relay migration is
#              worse than a slightly slower relay
#   disabled - no relay transport at all. Note this also means you cannot dial
#              a peer through *its* relay
#   custom   - one relay you run, and only that one; no N0 relay is used
relay_mode = "default"

# Only used when relay_mode = "custom"; setting relay_url without a relay_mode
# means custom. Pointing it at *.relay.n0.iroh.link is rejected (use pinned or
# default for those).
# relay_url = "https://relay.example.com"

# Bearer token for a self-hosted relay that requires one. Only meaningful for
# custom, and both sides need it.
# relay_auth_token = ""

# The same token, read from a file instead of this one — same idea as
# secret_key_file above, and the same refusal rules (empty, unreadable, or
# world-readable refuses; naming it here *and* in relay_auth_token refuses;
# NEXAPIPE_RELAY_AUTH_TOKEN carries it in the environment instead). A missing
# file is refused here rather than generated: the server cannot invent a
# token.
# relay_auth_token_file = ""

# Whether this endpoint may use n0's address lookup — the DNS and pkarr
# queries that turn a Node ID into "where do I send QUIC packets". It is the
# one piece of n0's infrastructure that relay_mode does not reach, so it has a
# setting of its own. Unset means n0.
#   n0    - the endpoint publishes its address there and resolves other
#           endpoints' addresses through it
#   none  - no lookup at all. Nothing about this endpoint reaches n0's lookup
#           service, and a Node ID alone no longer reaches this endpoint: a
#           client has to bring an address of its own, which is what the
#           ticket the server prints at start-up carries
# A value that is present but unknown refuses the start.
# discovery = "n0"

# ============================================================
# [log] - logging and rotation
# ============================================================

[log]
# Write log files. Default true.
file = true
# Log directory, default ./logs; NEXAPIPE_LOG_DIR overrides it.
dir = "./logs"
# Current log file name, default nexapipe.log; rotated copies are
# nexapipe.<timestamp>.log.
file_name = "nexapipe.log"
# One line per proxied request. Default true.
access_log = true
access_log_file_name = "access.log"
# Rotation period: daily (default) / hourly / never
rotation = "daily"
# Rotate above this size (MiB) as well; 0 = off. Default 0.
max_size_mb = 0
# Rotated files to keep; 0 = keep all. Default 14.
max_files = 14
# Also write to stdout. Default true.
console = true
# Replace query-string values with <redacted> in the log, keeping the
# names. Default true.
#   /api/items?token=hunter2&page=2 -> /api/items?token=<redacted>&page=<redacted>
# Tokens, signatures and one-time codes travel in query values, and a log file
# gets rotated, archived and handed around - so values are dropped and the names
# that make the line worth reading stay. Set false to log URIs verbatim.
#
# This covers every place a URI is written down: the access log and the
# general log, including the request line a tracing span carries. A URI that
# reached the span used to reach the general log file unredacted, while the
# access log's copy of the same URI was clean.
redact_query = true

# ============================================================
# [[routes]] - routing
# ============================================================

# 1) Plain HTTP: parse the request, apply path_pattern / path_rewrite, re-issue
#    it with the shared client. A backend may be http:// or https:// - an
#    https:// backend is reached over a TLS session the server originates and
#    verifies, so the server holds no certificate and still terminates nothing.
#    The backend's certificate is validated against the machine's trust store;
#    see [backends].
[[routes]]
host_pattern = "app.example.com"
path_pattern = "/"
path_is_prefix = true
strategy = "round_robin"          # or "random" or "least_conn"
backends = ["http://127.0.0.1:18080", "http://127.0.0.2:18080"]
mode = "http"                     # the default; may be omitted
# path_rewrite = "/api"           # rewrite the path prefix before forwarding
# backend_protocol = "h2c"        # speak HTTP/2 to a cleartext backend; see below
#
#    `backend_protocol` says how the server speaks to THIS route's backends.
#    Left out, the server speaks HTTP/1.1 to a cleartext backend, and HTTP/2
#    to an https:// one whenever the TLS handshake agrees on it - there is
#    nothing to configure for that. "h2c" is for the backend that speaks
#    HTTP/2 in the clear: there is no handshake on a cleartext connection to
#    agree on anything, so the server has to know and start speaking h2. An
#    https:// backend cannot be h2c - it speaks h2 through the handshake.
#
#    A WebSocket upgrade follows the same scheme. An https:// backend is reached
#    over TLS and verified against the trust store in [backends]; a cleartext
#    backend is reached in the clear. A route with backend_protocol = "h2c"
#    refuses a WebSocket rather than sending it an HTTP/1.1 upgrade the backend
#    did not ask for - WebSocket over HTTP/2 is not implemented.

# 2) passthrough: selected by SNI, bytes are copied verbatim, the backend
#    terminates TLS. The backend may be a bare host:port, and path_pattern /
#    path_rewrite do not apply.
[[routes]]
host_pattern = "web.example.com"
mode = "passthrough"
backends = ["127.0.0.1:443"]

# 3) tcp: carry a raw TCP flow to backends, selected by the host name in the L4
#    preface. client_ports is only a selector (it decides whether this route can
#    match); it never decides where the connection goes. Absent = every port
#    matches. Backends must spell out the port.
#    flow_timeout_secs = close the flow after this many seconds in total;
#    unset falls back to the server default. Raise it for a session that is
#    meant to last — an interactive SSH connection or a database session — since
#    the default bounds the whole flow, not the silence in it.
[[routes]]
host_pattern = "db.example.com"
mode = "tcp"
backends = ["127.0.0.1:5432"]
client_ports = [5432, 6432]
flow_timeout_secs = 3600

# 4) udp: UDP flows, one QUIC bi-stream per flow.
#    idle_timeout_secs = close the flow after this many silent seconds; unset
#    falls back to the server default.
[[routes]]
host_pattern = "turn.example.com"
mode = "udp"
backends = ["127.0.0.1:3478"]
idle_timeout_secs = 60

# 5) One host that has to answer both a request and a tunnel - the ordinary
#    shape for an Android TUN client: `modes` takes several, `mode` takes one.
#    They may be written together; the route serves the union, duplicates
#    collapse. The cost is that the address has to satisfy every declared mode,
#    and the L4 rules are stricter: the port must be written out. Give the modes
#    separate entries when they need different backends - a route has exactly
#    one backend pool.
[[routes]]
host_pattern = "vpn.example.com"
modes = ["passthrough", "tcp"]
backends = ["127.0.0.1:443"]

# ============================================================
# [health_check] - probing http backends
# ============================================================
# Every `mode = "http"` backend is asked `GET {backend}{path}` on a timer and
# leaves the pool after `threshold` consecutive failures. A `passthrough` or
# `tcp` route is probed by connecting to it (for passthrough, by completing the
# TLS handshake), which says a process is listening rather than that it works.
# A `udp`-only route is not probed: there is nothing to connect to.
#
# Set `enabled = false` when your backends cannot answer a probe on `{path}` -
# one that replies 5xx to an unknown path, or one that does not speak HTTP at
# all and so times out. A backend that answers 404 is already counted healthy,
# and so is any 2xx: a missing health endpoint is not on its own a reason to
# turn the checks off.
# Everything then stays in the pool and traffic is simply forwarded.
[health_check]
enabled = true
interval = 10
timeout = 5
threshold = 3
path = "/health"

# ============================================================
# [backends] - how the server reaches the backends
# ============================================================
# The trust store an https:// backend's certificate is checked against: the
# machine's own roots, plus whatever `ca_file` names. A backend signed by an
# internal authority needs that authority, and everything else keeps working.
#
# There is deliberately no way to skip the check: a proxy that connects to a
# backend without knowing who it is talking to can be redirected by whoever
# answers the name. A backend whose certificate this server cannot verify is a
# backend this server does not reach.
#
# A host with no roots of its own - a container image without
# `ca-certificates`, say - falls back to Mozilla's bundled roots rather than
# trusting nothing at all.
#
# NOT hot-reloadable: read once at startup, so editing this takes a restart.
# [backends]
# ca_file = "/etc/nexapipe/internal-ca.pem"

# ============================================================
# [retry] - trying a failed request again
# ============================================================
# How many times a request that failed may be tried again, and how long to
# wait between two attempts. Left out, a failed request is not tried again.
# Both the iroh tunnel and the plaintext listener apply it.
#
# `attempts` is the number of extra attempts, so 2 means up to three tries in
# total. It is capped at 16; `backoff_ms` is capped at 60000.
#
# A retry asks the route for a *different* backend, because the one that just
# failed is the one most likely to fail again. A route with a single backend
# has nobody else to ask and is asked again.
#
# What may be tried again depends on what failed:
#
#   - A request that never reached the backend - the connection was refused,
#     the name did not resolve, the handshake failed - is tried again whatever
#     it is. The backend never saw it.
#   - A request that was carried and then lost is tried again only if it is
#     idempotent. A GET is; a POST that charges a card is not, and the only
#     way to know is what the method says.
#
# An answer is never retried, and neither is a response the client has already
# started to receive.
#
# NOT hot-reloadable: read once at startup, so editing this takes a restart.
# [retry]
# attempts = 2
# backoff_ms = 100

# ============================================================
# [circuit_breaker] - a backend that keeps failing leaves the rotation
# ============================================================
# How many failures in a row take a backend out of rotation, and how long it
# stays out. The circuit is on unless `enabled = false`. While it is open the
# route answers 503 rather than dialling a backend that is known to be down -
# which spends a whole connect timeout to say what the server already knows.
# `failure_threshold` is capped at 1000 and `reset_secs` at 3600.
#
# A health probe says what a backend looked like the last time somebody asked.
# The circuit says what the traffic itself found. The two answer different
# questions, and both are on at once: the probe is periodic and the failure is
# immediate. The circuit counts the HTTP request paths, including the tunnel's
# streaming path and a WebSocket handshake; a session that dies after the upgrade
# does not count. A TCP or UDP route keeps using the health probe.
#
# The failures that count are the ones that say the backend is unreachable: the
# connection was refused, the name did not resolve, the answer never came. A
# response that broke halfway is not the backend's fault - it answered.
#
# NOT hot-reloadable: read once at startup, so editing this takes a restart.
# [circuit_breaker]
# enabled = true
# failure_threshold = 5
# reset_secs = 30

# ============================================================
# [timeouts] - waiting on a backend, and bounding each phase
# ============================================================
# Every key is seconds and optional; leaving the section out keeps the deadlines
# this server has always used. The first two keys cover one step of talking to a
# backend each - neither bounds how long a request may take, and a response body
# may then stream for as long as it needs (the six keys further down bound the
# phases of the exchange itself):
#
#   connect_secs   dialing a backend: the HTTP request paths (including a
#                  WebSocket upgrade), TLS passthrough and tcp tunnels all dial
#                  exactly one connection, and all four wait this long for it.
#                  Raise it for a backend across a slow or lossy link.
#                  Default: 10
#   response_secs  waiting for a backend's answer - its status line, or for a
#                  WebSocket, its upgrade response. It ends as soon as the head
#                  arrives. Raise it for an API that computes before it answers.
#                  Default: 30
#
# For these two keys `0` is refused at startup, and so is anything past 3600:
# the first is a deadline no backend can meet, and the second is not a slow
# backend but one that has stopped answering - and then nothing is holding the
# request slot.
#
# The six keys below bound the phases of the exchange itself rather than the
# backend's patience: how long a *client* may take to send its head and body,
# how long a streamed response may go silent between chunks, how long an L4
# tunnel may run, how idle a UDP flow may go, and how long a TLS ClientHello
# may take. Each is optional, and leaving a key out keeps its default; the
# distinction that decides each default is phase deadline (taken once, never
# renewed - what a one-byte trickle cannot outwait) versus idle (re-armed on
# every chunk or datagram, correct only where the phase is meant to stay open):
#
#   header_secs        a phase deadline over the whole request head. On the
#                      plaintext listener it covers the whole wait for the
#                      head, the peek that tells a TLS session from a request
#                      included. Default: 30
#   body_secs          a phase deadline over the whole request body, separate
#                      from the head because a large upload legitimately takes
#                      longer. Default: 300
#   response_idle_secs idle between response chunks, on every path that proxies
#                      a response, so an SSE stream or a long transfer stays
#                      open while a silent backend does not hold the slot.
#                      Default: 120
#   l4_flow_secs       a phase deadline over the whole life of an L4 tunnel,
#                      TCP and UDP alike: a flow has no protocol-level end, so
#                      this is the one stop against a peer renewing it
#                      forever. Raise it for a long-lived SSH or database
#                      session over the tunnel; a route's own
#                      `flow_timeout_secs` overrides it per route.
#                      Default: 3600
#   l4_idle_secs       idle between UDP datagrams in either direction.
#                      Default: 60
#   tls_hello_secs     a phase deadline over the TLS ClientHello read. The
#                      wait for the session's first byte is the longer of
#                      this and `header_secs`. Default: 10
#
# A stream's first byte says which protocol it carries, and until it arrives
# the protocol is unknown - so the wait for it is the longer of `header_secs`
# and `tls_hello_secs`, never the head's alone. A short `header_secs` does not
# cut off a TLS session or an L4 tunnel: neither ever sends a request head,
# and both are bounded by their own keys.
#
# These six take the wider ceiling: `0` is refused for every key, and so is
# anything past 86400 (a day) - the first closes the phase the moment it opens,
# and the second is a bound that never fires. The two backend keys above keep
# the tighter 3600.
#
# NOT hot-reloadable: read once at startup, so editing any of these takes a
# restart.
# [timeouts]
# connect_secs = 10
# response_secs = 30
# header_secs = 30
# body_secs = 300
# response_idle_secs = 120
# l4_flow_secs = 3600
# l4_idle_secs = 60
# tls_hello_secs = 10

# ============================================================
# [limits] - the ceilings the whole process runs under
# ============================================================
# Every key is optional; leaving the section out keeps the ceilings this server
# has always used.
#
#   max_connections_per_peer  connections one peer may hold at once. The client
#                              pool opens a connection per in-flight request, so
#                              a busy client holds several - this is here to stop
#                              a peer from holding thousands, not to shape
#                              traffic. Default: 64
#   max_connections_global    connections the whole process may hold. A peer id
#                              is a public key, so a caller can invent as many
#                              peers as it likes and the total would be a
#                              product of "64 times however many you care to
#                              generate". Neither ceiling subsumes the other.
#                              Default: 4096
#   max_streams_global        streams in flight across every connection - each
#                              connection may open its own allowance, so the
#                              total is the same product one level down.
#                              Default: 16384
#   max_body_bytes            bytes of request bodies held at once. Bodies are
#                              read whole before being forwarded, so 64 MB per
#                              request is defensible and the same 64 MB times
#                              every stream at once is not. Default: 1 GiB
#
# A zero is refused at startup for every key: a ceiling of 0 would refuse every
# connection rather than bound them, which is a typo rather than a setting. It
# is refused even when the matching environment variable is set - the
# environment overrides a value that works, not one that does not. An unknown
# key is refused at load, before the server starts at all - a misspelled limit
# is one that silently does not apply.
#
# The three connection and stream ceilings are counted against the iroh
# tunnel, because that is where a peer is. The plaintext listener has no peer
# to count against and no ceiling of its own; the byte budget is shared by
# both listeners and so does bound it.
#
# The four environment variables that named these ceilings before this section
# existed - NEXAPIPE_MAX_CONNS_PER_PEER, NEXAPIPE_MAX_CONNS,
# NEXAPIPE_MAX_STREAMS and NEXAPIPE_MAX_BODY_BYTES - still work, and the
# environment wins over the config. A key both name is a warning in the log.
#
# NOT hot-reloadable: read once at startup, so editing any of these takes a
# restart.
# [limits]
# max_connections_per_peer = 64
# max_connections_global = 4096
# max_streams_global = 16384
# max_body_bytes = 1073741824

# ============================================================
# [admin] - the auxiliary listener (off by default)
# ============================================================
# A second, loopback-only listener that answers questions about this instance
# instead of forwarding traffic:
#   GET /healthz  -> 200 "ok" for as long as the process is serving
#   GET /metrics  -> instance metrics in Prometheus text format
#                    (only while [metrics] enabled = true below)
#   GET /v1/*     -> the same instance as JSON, behind a token
#
# There is no `token` key here. The token is generated on first start into
# <this file>.admin-token, readable only by this account; `nexapipe status`
# reads it from there. A key here would put a credential into the file you
# edit, copy and commit.
#
# Absent means the listener is not bound at all, which is the default: an
# instance nobody scrapes or supervises should not hold a port open.
#
# Loopback only, and there is no `expose` escape hatch: nothing here
# authenticates, and the answer names your routes, clients and backends. Reach
# it from another host with an SSH tunnel, not with a bind address.
#
# `listen_addr` is NOT hot-reloadable - moving a listener is a restart.
# [admin]
# listen_addr = "127.0.0.1:9090"

# ============================================================
# [metrics] - whether /metrics is served
# ============================================================
# Off by default, because the listener it hangs off is unauthenticated: nothing
# is exposed until you ask for it here AND bind an [admin] address. Turning
# this on without an [admin] section logs a warning and serves nothing.
[metrics]
enabled = false

# ============================================================
# [local_proxy] - client mode (delete the section on a server)
# ============================================================

[local_proxy]
enabled = false
listen_addr = "127.0.0.1:8081"
# The local proxy does not authenticate the peer that connects to it: it hands
# out the tunnel of a connection that has already authenticated, so whoever
# reaches the port gets that tunnel without a credential. `listen_addr`
# therefore has to name a loopback address, and a non-loopback one is refused
# at startup. `expose = true` is the explicit opt-in for a deployment that
# puts something else in front of the port — a firewall, a container network —
# and it means the same thing as `[server] expose`.
expose = false
# Domains to tunnel; --generate-invite without --invite-domains takes its
# domains from here too.
#
# The same spelling a route's `host_pattern` uses, so a pattern can be copied
# from one list to the other:
#
#   app.example.com    that name, exactly
#   *.example.com      its subdomains, and not the name itself
#   *                  every name
#
# A bare domain meant the name and every subdomain on the client while the
# server read it as the name alone, so a subdomain the client put in the
# tunnel was a name the server had no route for. It means the name alone now,
# on both sides: write "*.example.com" for the subdomains. A client that
# carries an older list says so in its log, once, at startup.
proxy_domains = ["app.example.com", "web.example.com"]
strategy = "round_robin"

# Preferred form: several server nodes. The same domain may appear on more than
# one node - that is how you load balance across servers. Replace the Node ID
# with the one the server prints (64 hex chars).
[[local_proxy.nodes]]
server_node_id = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
domains = ["app.example.com"]

# A full ticket (Node ID + addresses) works too: it changes whenever the
# addresses do, but it carries the complete connection information.
# [[local_proxy.nodes]]
# server_ticket = "nodeabc...#addresses"
# domains = ["web.example.com"]

# Deprecated single-node keys, still honoured: server_ticket / server_node_id.
# Prefer [[local_proxy.nodes]].
# server_node_id = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# server_ticket  = "full ticket"

# Client 2FA credentials: must match a client listed under [auth.clients] on the
# server, otherwise every connection is rejected. See config.toml.2fa.example.
# [local_proxy.two_factor]
# enabled = true
# client_id = "client-001"
# secret = "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"
# algorithm = "sha1"

# ============================================================
# [peers] - which client Node IDs may connect at all (optional)
# ============================================================
# An allow-list of client public keys, checked during the QUIC handshake: a peer
# that is not on it is closed before any stream is opened or any slot is taken.
# With no [peers] section, every Node ID that can reach the endpoint proceeds to
# the next check - which, with [auth] off too, means the Node ID alone reaches
# every route. This is not a substitute for 2FA: it answers "may this Node ID be
# here", where 2FA answers "who is it". Use both when you can.
#
# Take each Node ID from the client app that owns it: this list names clients,
# and the Node ID in the server's own startup log is the server's - putting it
# here allows nobody. A typo is a startup error rather than a silently skipped
# entry, and an empty list is refused outright - it would lock you out of your
# own server.
#
# [peers]
# allow = [
#   "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2",
# ]

# ============================================================
# [auth] - server-side 2FA (on in this file)
# ============================================================
# With this on, every client connection must complete a TOTP handshake before
# proxying is allowed. The secrets below are the only credential gating the iroh
# listener. Config file permissions are no longer enforced, so keep this file
# private (chmod 600 is recommended) or move credentials into sidecar files /
# the environment.
#
# What turning it on costs: a credential to hand out. Every client needs a
# secret of its own, and that secret travels to the device in an invite link
# or a QR code - so enrolling a client is a deliberate act, not a side effect
# of starting the server.
#
# What leaving it off means: nothing is asked of a client but its Node ID. With
# no [peers] list either, the Node ID alone reaches every route and every
# backend - it is in every invite link, in the client's own configuration and
# in screenshots - and the server says so, loudly, at startup.
#
# Generate a secret and its enrollment QR code (both write the result back into
# config.toml, so do not point them at the example file itself):
#   nexapipe --generate-2fa client-001 --config config.toml
#   nexapipe --generate-invite client-001 --config config.toml
#
# The invite above carries the secret in the clear, so the code itself is the
# credential. `--registration` swaps it for a one-time enrollment token:
#   nexapipe --generate-invite client-001 --registration --config config.toml
# That token lands in `pending_enrollment` here; the first device to scan it
# trades it for a fresh secret and the token is spent - see
# config.toml.2fa.example for the full flow.
#
# This file ships with 2FA on and no client enrolled, so nothing can connect
# until you enroll the first one - which is the point: the first credential is
# handed out on purpose.
#   nexapipe --generate-invite client-001 --create-client --config config.toml
[auth]
enabled = true
# issuer = "NexaPipe"
# algorithm = "sha1"      # sha1 / sha256 / sha512
# time_step = 30
# digits = 6
# window = 1
# max_attempts = 5
# lockout_duration = 300
#
# [auth.clients.client-001]
# secret = "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"
# created_at = "1723756800"
# allow_hosts = ["app.example.com", "*.db.example.com"]   # unset = every route
# allow_ports = [443, 8443]                                # unset = every port
#
# The port list is the weaker half of this section by default, and the name of
# the flag does not say which one you have. With allow_ports_strict off (the
# default) the list is checked against the port the client NAMES - the one in
# the tunnel preface, or the one in a request's Host header - and a request
# that names no port is not checked at all. So a client limited to 443 that
# asks for "app.example.com" with no port is not refused, and the request is
# served from whatever port the backend happens to listen on.
#
# allow_ports_strict = true checks the list against the port the request is
# SERVED FROM - the backend's own port - which is the stronger rule and the
# one an allow-list of ports is written for. It is off by default, because
# turning it on changes what an existing configuration allows: a client limited
# to 443 whose route's backend listens on 18080 is refused. That is the
# correct answer, and it is not the answer a deployed configuration was
# written against - so turn it on having looked at where your backends
# actually listen.
#
# The server says so at startup, and `nexapipe client list` says it too, when a
# client has a port list and the strict flag is off.
# allow_ports_strict = true
